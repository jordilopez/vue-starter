{
  "name": "vue-starter",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "lint-staged": {
    "*.{ts,vue,css,json,md}": "npx prettier --write",
    "*.{ts,vue}": "npx eslint --fix",
    "*": "gitleaks protect --staged"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\"",
    "lint": "eslint src/",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.60.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/vue3-vite": "^10.4.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "playwright": "1.60.0",
    "postcss-custom-media": "^12.0.1",
    "storybook": "^10.4.1",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@storybook/addon-themes": "^10.4.1",
    "css-starter": "github:jordilopez/css-starter#v0.2.1",
    "vue": "^3.5.34"
  }
}
